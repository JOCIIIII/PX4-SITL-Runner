#!/bin/sh
#
# @name Gazebo X500 (A4VAI test quad)
#
# @type Quadrotor x
# @class Copter
#
# SITL counterpart of the A4VAI X500 (Holybro X500 frame, Pixhawk 6X, 4S). Allocation, thrust
# model factor and all controller gains/limits are the vehicle's own (flight logs 2026-06-28 ..
# 2026-10-02, SYS_AUTOSTART 4001 generic quad x, PX4 v1.16.0); the dynamics live in the x500
# Gazebo model (scripts/px4/x500/README.md). Installed by scripts/px4/build.sh.

. ${R}etc/init.d/rc.mc_defaults

param set-default MAV_TYPE 2

# ---- control allocation (vehicle CA_*: generic quad x, unit arms, KM > 0 = CCW) ----
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4
param set-default CA_ROTOR0_PX 1
param set-default CA_ROTOR0_PY 1
param set-default CA_ROTOR0_KM 0.05
param set-default CA_ROTOR1_PX -1
param set-default CA_ROTOR1_PY -1
param set-default CA_ROTOR1_KM 0.05
param set-default CA_ROTOR2_PX 1
param set-default CA_ROTOR2_PY -1
param set-default CA_ROTOR2_KM -0.05
param set-default CA_ROTOR3_PX -1
param set-default CA_ROTOR3_PY 1
param set-default CA_ROTOR3_KM -0.05

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104

# ---- thrust (vehicle): linear thrust model, hover-thrust estimator on from 0.5 ----
param set-default THR_MDL_FAC 0
param set-default MPC_THR_HOVER 0.5
param set-default MPC_USE_HTE 1
param set-default MPC_THR_MIN 0.12
param set-default MPC_THR_MAX 1.0
param set-default MPC_THR_XY_MARG 0.3

# ---- rate / attitude control (vehicle: PX4 defaults, never autotuned) ----
param set-default MC_ROLLRATE_P 0.15
param set-default MC_ROLLRATE_I 0.2
param set-default MC_ROLLRATE_D 0.003
param set-default MC_ROLLRATE_K 1.0
param set-default MC_ROLL_P 6.5
param set-default MC_PITCHRATE_P 0.15
param set-default MC_PITCHRATE_I 0.2
param set-default MC_PITCHRATE_D 0.003
param set-default MC_PITCHRATE_K 1.0
param set-default MC_PITCH_P 6.5
param set-default MC_YAWRATE_P 0.2
param set-default MC_YAWRATE_I 0.1
param set-default MC_YAWRATE_D 0.0
param set-default MC_YAWRATE_K 1.0
param set-default MC_YAW_P 2.8
param set-default MC_YAW_WEIGHT 0.4
param set-default MC_ROLLRATE_MAX 220
param set-default MC_PITCHRATE_MAX 220
param set-default MC_YAWRATE_MAX 200
param set-default IMU_GYRO_CUTOFF 40
param set-default IMU_DGYRO_CUTOFF 30

# ---- position control / limits (vehicle) ----
param set-default MPC_TILTMAX_AIR 45
param set-default MPC_MAN_TILT_MAX 35
param set-default MPC_XY_P 0.95
param set-default MPC_Z_P 1.0
param set-default MPC_XY_VEL_P_ACC 1.3
param set-default MPC_XY_VEL_I_ACC 0.4
param set-default MPC_XY_VEL_D_ACC 0.2
param set-default MPC_Z_VEL_P_ACC 4.0
param set-default MPC_Z_VEL_I_ACC 2.0
param set-default MPC_Z_VEL_D_ACC 0.0
param set-default MPC_XY_VEL_MAX 12
param set-default MPC_XY_CRUISE 5
param set-default MPC_VEL_MANUAL 10
param set-default MPC_Z_VEL_MAX_UP 3.0
param set-default MPC_Z_VEL_MAX_DN 1.5
param set-default MPC_Z_V_AUTO_UP 3.0
param set-default MPC_Z_V_AUTO_DN 1.5
param set-default MPC_ACC_HOR 3.0
param set-default MPC_ACC_HOR_MAX 5.0
param set-default MPC_ACC_UP_MAX 4.0
param set-default MPC_ACC_DOWN_MAX 3.0
param set-default MPC_JERK_AUTO 4.0
param set-default MPC_JERK_MAX 8.0
param set-default MPC_YAWRAUTO_MAX 45
param set-default MPC_LAND_SPEED 0.7
param set-default MPC_TKO_SPEED 1.5
param set-default MIS_TAKEOFF_ALT 2.5

param set-default BAT1_N_CELLS 4

# SITL sensors: single simulated IMU
param set-default EKF2_MULTI_IMU 0
param set-default SENS_IMU_MODE 0
