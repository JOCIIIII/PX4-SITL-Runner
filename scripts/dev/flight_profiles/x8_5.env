# X8, 5 m/s. Sourced by scripts/dev/pils_gate.sh and scripts/dev/onboard_real.sh fly (see README.md)
PROFILE_AIRFRAME=x8
NOCLIMB_POLICY_DIR=x8_30m_soft_onnx
NOCLIMB_POLICY=ca_x8_30m_soft
NOCLIMB_DRIVER=flight_driver
NOCLIMB_GUID=2
NOCLIMB_CMD_TAU=0.3
NOCLIMB_MAX_TILT_RATE=0.8
NOCLIMB_SCAN_MEMORY=0.4
NOCLIMB_SCAN_MEMORY_MIN=5
NOCLIMB_DENSITY=cluster
NOCLIMB_MAX_TILT_DEG=30
# the X8's thrust scale is already its own (octo.yaml: 10.4 kg hover at 0.444 = the vehicle's hover PWM 1515 us)
NOCLIMB_HOVER_THRUST=0
# vehicle only (NOCLIMB_LIDAR=livox); MEASURE all on the X8: scripts/dev/lidar_mount_calib.py,
# livox_bench_check.py (its arms and props reach 0.77 m - the self-return radius is larger than the X500's)
NOCLIMB_LIDAR_YAW_DEG=180
NOCLIMB_LIDAR_ROLL_DEG=0
NOCLIMB_LIDAR_PITCH_DEG=0
NOCLIMB_LIDAR_Z=0.3
NOCLIMB_LIDAR_LATENCY=0.02
NOCLIMB_SELF_RADIUS=0.9
# the X8's Mid-360 (each unit has its own address; X500 192.168.1.100)
LIVOX_LIDAR_IP=192.168.1.182
