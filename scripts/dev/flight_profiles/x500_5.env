# X500, 5 m/s. Sourced by scripts/dev/pils_gate.sh and scripts/dev/onboard_real.sh fly (see README.md)
PROFILE_AIRFRAME=x500
NOCLIMB_POLICY_DIR=x500_onnx
NOCLIMB_POLICY=ca_x500
NOCLIMB_DRIVER=flight_driver
NOCLIMB_GUID=2
NOCLIMB_CMD_TAU=0.3
NOCLIMB_MAX_TILT_RATE=0.8
NOCLIMB_SCAN_MEMORY=0.4
NOCLIMB_SCAN_MEMORY_MIN=5
NOCLIMB_DENSITY=cluster
NOCLIMB_MAX_TILT_DEG=30
# MEASURE: the first hover's hover_thrust_estimate (real X500 logs 10-02: 0.644-0.645, before the lidar went on)
NOCLIMB_HOVER_THRUST=0.645
# vehicle only (NOCLIMB_LIDAR=livox); MEASURE: scripts/dev/lidar_mount_calib.py
NOCLIMB_LIDAR_YAW_DEG=180
NOCLIMB_LIDAR_ROLL_DEG=0
NOCLIMB_LIDAR_PITCH_DEG=0
NOCLIMB_LIDAR_Z=0.1
NOCLIMB_LIDAR_LATENCY=0.02
NOCLIMB_SELF_RADIUS=0.55
