# X8, 5 m/s candidate x8_final_onnx/v5_smooth2 (smoother, 2026-10-17 bundle), x8_5s knobs. Sourced by scripts/dev/pils_gate.sh and scripts/dev/onboard_real.sh fly (see README.md)
PROFILE_AIRFRAME=x8
NOCLIMB_POLICY_DIR=x8_final_onnx/v5_smooth2
NOCLIMB_POLICY=ca_x8_30m_smooth
NOCLIMB_DRIVER=flight_driver
NOCLIMB_GUID=2
NOCLIMB_CMD_TAU=0.3
NOCLIMB_CMD_ACCEL_MAX=1.5
NOCLIMB_MAX_TILT_RATE=0.8
NOCLIMB_SCAN_MEMORY=0.4
NOCLIMB_SCAN_MEMORY_MIN=5
NOCLIMB_DENSITY=cluster
NOCLIMB_MAX_TILT_DEG=30
# the X8's thrust scale is already its own (octo.yaml: 10.4 kg hover at 0.444 = the vehicle's hover PWM 1515 us)
NOCLIMB_HOVER_THRUST=0
# vehicle only (onboard_real.sh): MEASURED 2026-11-04 on the X8 (with the X500's Mid-360 and the Jetson): the thrust
# commands in steady level flight of three flights at 1.0-1.5 m were 0.342 / 0.362 / 0.352 (some ground effect)
# - the model's 0.444 (octo.yaml) stays for SILS / PILS. Confirm with PX4's hover_thrust_estimate (SD card log).
VEHICLE_NOCLIMB_HOVER_THRUST=0.36
# vehicle only (NOCLIMB_LIDAR=livox) - MEASURED on the X8 2026-11-03 (scripts/dev/lidar_mount_calib.py) with the
# Mid-360 moved over from the X500 (192.168.1.100): target = a person on the nose axis -> yaw 0 (the lidar's +X, away
# from its connector, looks forward - NOT the X500's 180; the 11-02 crash flew with 180), rest --yaw 0: roll / pitch,
# lidar 0.653 m above the ground. Re-measure when the lidar or its bracket changes.
NOCLIMB_LIDAR_YAW_DEG=0
NOCLIMB_LIDAR_ROLL_DEG=-0.07
NOCLIMB_LIDAR_PITCH_DEG=-2.28
# NOCLIMB_LIDAR_Z / ground: the simulated X8 (SILS / PILS) has its lidar 0.30 m above a centre 0.44 m up; the vehicle's
# own values are the VEHICLE_ lines, which scripts/dev/onboard_real.sh uses instead (the vehicle's centre 0.55 m up)
NOCLIMB_LIDAR_Z=0.3
VEHICLE_NOCLIMB_LIDAR_Z=0.103
VEHICLE_NOCLIMB_GROUND_Z=-0.55
VEHICLE_NOCLIMB_AGL_OFFSET=0.55
NOCLIMB_LIDAR_LATENCY=0.02
# livox_bench_check.py: its arms and props reach 0.77 m - the self-return radius is larger than the X500's
NOCLIMB_SELF_RADIUS=0.9
# the Mid-360 on the X8 now: the X500's unit (the X8's own one, 192.168.1.182, is off the vehicle since 11-02)
LIVOX_LIDAR_IP=192.168.1.100
