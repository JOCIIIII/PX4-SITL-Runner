# AUTOSET VARIABLES (CONTROLLED BY scripts/run.sh)
## DO NOT MODIFY THIS SECTION
# >>>----------------------------------------------------

ROS2_WORKSPACE=""
ROS2_RUN_COMMAND=""
ROS2_IP=""
SITL_AIRFRAME=""        # copied from envs/gazebo-classic.env (x8 | iris): apps pick the vehicle configs

# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<



# STATIC VARIABLES
## DO NOT MODIFY THIS SECTION UNLESS YOU KNOW WHAT YOU ARE DOING
# >>>----------------------------------------------------

ROS2_ENV_IMAGE=jociiiii/a4vai:inhousesim-v0.9
ROS2_ENV_CONTAINER=ros2-env

# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<



# MANUALSET VARIABLES
## YOU CAN MODIFY THIS SECTION
# >>>----------------------------------------------------

# ROS2 APP TO AUTO-RUN ON `gazebo-classic-sitl run`.
# RUNS scripts/ros2/apps/<ROS2_APP>.sh (the uXRCE-DDS agent always runs alongside it).
# TO ADD A NEW APP: drop a new scripts/ros2/apps/<name>.sh and set ROS2_APP="<name>".
# LEAVE EMPTY (ROS2_APP="") TO ONLY RUN THE AGENT AND IDLE.
# ROS2_APP="velocity_offboard_test"
# ROS2_APP="position_offboard_test"
ROS2_APP="super_pf"

# super_pf: cruise speed [m/s] - SUPER plans with this max_vel (a copy of its config is made
# per run) and PathFollowing is capped at it.
SUPER_PF_MAX_SPEED=7.0
# super_pf: within this horizontal distance [m] of the final goal flight_manager takes over from
# PathFollowing with PX4 position control, stops at the goal and lands there (0 = PF to the end).
SUPER_PF_GOAL_HANDOVER_M=3.0

# noclimb_ca: learned no-climb avoidance policy (ros2_ws/src/Inhouse-collision-avoidance/
# noclimb_onnx) -> PathFollowing. ca_noclimb_tau05-12 | ca_noclimb_tau03-08 (assumed
# follower speed-response time 0.5-1.2 s | 0.3-0.8 s). Other knobs: scripts/ros2/apps/noclimb_ca.sh
NOCLIMB_POLICY=ca_noclimb_tau05-12
NOCLIMB_SCAN_MEMORY=0
# noclimb_ca: PathFollowing guidance for the policy's waypoints - 2 = MPPI (node_mppi on the GPU,
# pathfollowing config sim_ca_mppi.yaml, x8: sim_ca_mppi_x8.yaml; flown at 5 m/s), 0 = speed-mode
# pursuit. NOCLIMB_CMD_TAU: first-order smoothing [s] of the policy's 20 Hz commands (0 = off).
# Per-airframe (iris | x8) knobs: scripts/ros2/apps/noclimb_ca.sh.
NOCLIMB_GUID=2
NOCLIMB_CMD_TAU=0.3

# STATE_YOUR_VARIABLES_HERE=""

# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
