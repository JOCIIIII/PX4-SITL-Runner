# AUTOSET VARIABLES (CONTROLLED BY scripts/run.sh)
## DO NOT MODIFY THIS SECTION
# >>>----------------------------------------------------

AIRSIM_WORKSPACE=""
AIRSIM_RUN_COMMAND=""
AIRSIM_IP=""

# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<



# STATIC VARIABLES
## DO NOT MODIFY THIS SECTION UNLESS YOU KNOW WHAT YOU ARE DOING
# >>>----------------------------------------------------

AIRSIM_BINARY_IMAGE=docker.io/kestr3l/airsim:22.04-cudagl12-x11
AIRSIM_BINARY_CONTAINER=airsim-binary

# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<



# MANUALSET VARIABLES
## YOU CAN MODIFY THIS SECTION
# >>>----------------------------------------------------

# STATE_YOUR_VARIABLES_HERE=""

# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

# Unreal launch arguments. -windowed shows the AirSim view; -RenderOffScreen renders without a
# window. Note: AirSim can take minutes to answer its API after start-up on this host (worst
# with the monitor powered off); the ROS2 apps wait up to 300 s for lidar before arming.
AIRSIM_RENDER_ARGS=-windowed
